---
// Header component with pill navigation, GWD logo, navigation links, and theme toggle
---

<header class="nav">
  <div class="wrap">
    <a class="brand" href="#top" aria-label="GWD Club, back to top">
      <span class="chip-logo">
        <span class="logo-mark" role="img" aria-label="GWD"></span>
      </span>
      <span class="brand-txt">Club · Hyderabad</span>
      <i class="live" aria-hidden="true"></i>
    </a>
    <span class="coords" aria-hidden="true">X0000 Y0000</span>
    <ul>
      <li><a href="#identity">Identity</a></li>
      <li><a href="#verticals">Verticals</a></li>
      <li><a href="#bootcamp">Execution</a></li>
      <li><a href="#roadmap">Roadmap</a></li>
      <li><a href="#team">Team</a></li>
    </ul>
    <div class="nav-r">
      <button id="theme" type="button" aria-label="Switch to light mode">
        <svg class="sn" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
        <svg class="mn" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
        </svg>
      </button>
      <a class="btn btn-solid btn-sm" href="#join">
        Join the club
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6"></path>
        </svg>
      </a>
    </div>
  </div>
</header>
