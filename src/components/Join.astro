---
// Join section
---

<section class="sec" id="join">
  <div class="wrap">
    <div class="split">
      <div class="stack">
        <p class="eyebrow">Join</p>
        <h2 class="h2">Build with GWD Club.</h2>
        <div class="body">
          <p>Students at VJIT join the flagship hub and pick a vertical. Students on other campuses can register interest as new chapters open.</p>
        </div>
        <div class="channels">
          <div class="channel"><b>WhatsApp community</b><span class="slot">Link to be added</span></div>
          <div class="channel"><b>Instagram</b><span class="slot">Handle to be added</span></div>
          <div class="channel"><b>LinkedIn</b><span class="slot">Page to be added</span></div>
          <div class="channel"><b>Email</b><span class="slot">Address to be added</span></div>
        </div>
      </div>
      <div class="col-stage">
        <div class="stage" data-stage="join" role="img" aria-label="Six nodes orbiting a core inside the GWD corner brackets">
          <p class="cap">Six verticals, one frame</p>
        </div>
      </div>
    </div>
  </div>
</section>
