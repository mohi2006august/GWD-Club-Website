---
import { SECTIONS } from '../data/content';
---

<nav class="rail" id="rail" aria-label="Sections">
  {SECTIONS.map(([id, label], i) => (
    <a href={`#${id}`} aria-current={i === 0 ? "true" : undefined}>
      <span>{label}</span>
      <i></i>
    </a>
  ))}
  <div class="depth">
    DEPTH<b id="depth">0%</b>
  </div>
</nav>
